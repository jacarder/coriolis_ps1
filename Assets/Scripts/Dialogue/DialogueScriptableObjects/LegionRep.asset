  RootNode:
    dialogueText: "\"Civilian. You\u2019re in Legion space. State your business.\""
    clip: {fileID: 8300000, guid: 583afb22e08ebd946bb835af3cda5949, type: 3}
    responses:
    - responseText: Looking for work.
      nextNode:
        dialogueText: "\"Everyone is. Most can\u2019t stomach it. What makes you
          different?\""
        clip: {fileID: 8300000, guid: 2e0da7486bbe61d488e83b89689b2d9a, type: 3}
        responses:
        - responseText: I follow orders.
          nextNode:
            dialogueText: "\u201CResults matter. Orders matter more. Survival is
              optional.\u201D  He studies you, then lowers his voice. \u201CPatrol
              went silent near the Kua Belt. No beacon. No bodies. Legion doesn\u2019t
              like mysteries.\u201D"
            clip: {fileID: 8300000, guid: 0f5ba1494baf5d342b94b5f85da854b1, type: 3}
            responses:
            - responseText: What's the pay?
              nextNode:
                dialogueText: 
                clip: {fileID: 0}
                responses: []
              isSkillCheck: 0
              startQuestId: 
              advancedQuestId: 
              finishQuestId: 
              skill: 0
              returnToParent: 0
            - responseText: Who were they?
              nextNode:
                dialogueText: 
                clip: {fileID: 0}
                responses: []
              isSkillCheck: 0
              startQuestId: 
              advancedQuestId: 
              finishQuestId: 
