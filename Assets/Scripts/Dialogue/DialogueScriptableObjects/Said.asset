  RootNode:
    dialogueText: Why, hello there friend. May the Martyr bless you.
    dialogueCriticalText: 
    dialogueFailText: 
    clip: {fileID: 0}
    responses:
    - responseText: Are you a Samaritan?
      nextNode:
        dialogueText: Yes child I am. We are all the Martyrs children.
        dialogueCriticalText: 
        dialogueFailText: 
        clip: {fileID: 0}
        responses:
        - responseText: Give me all your money
          nextNode:
            dialogueText: '"If money is what you need, then here''s two birr for
              you.'
            dialogueCriticalText: '"Please, not in a place of worship. Here, take
              all that I have."'
            dialogueFailText: '"The Martyr protects. I fear nothing from you so long
              as the Martyr protects."'
            clip: {fileID: 0}
            responses:
            - responseText: END
              nextNode:
                dialogueText: 
                dialogueCriticalText: 
                dialogueFailText: 
